NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_CONNECT_ON_STARTUP=true
HOST=0.0.0.0
DATABASE_CONNECT_ATTEMPTS=3
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
WEB_APP_ORIGIN=http://localhost:3001
MOBILE_APP_ORIGIN=exp://localhost:8081
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
GEMINI_API_KEY=
GEMINI_FALLBACK_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_IDENTIFICATION_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.7-flash
GEMINI_SPACE_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional separate image-enabled project key; defaults to GEMINI_API_KEY.
# GEMINI_IMAGE_API_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODELS=gpt-5.6-luna,gpt-5.6-terra
SUPPORT_API_KEY=replace-with-a-random-32-character-secret

# Email OTP: local secrets only; never put these in EXPO_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=
OTP_HASH_SECRET=
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
MAX_OTP_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
